#!/bin/bash

# default is to test app using picoc
CMD=$1
if [ "$CMD" = "" ]; then
    CMD=picoc
fi

# get CMD and validate
if [ "$CMD" != build -a "$CMD" != linux -a "$CMD" != picoc ]; then
    echo "ERROR: expected: build, linux, or picoc"
    echo "ERROR: default is picoc"
    exit 1
fi

# verify parent directory is 'apps' or 'svcs'
PARENT_DIR=$(basename $(dirname $PWD))
if [ "$PARENT_DIR" != apps -a "$PARENT_DIR" != svcs ]; then
    echo "ERROR: parent_dir must be apps or svcs"
    exit 1
fi

# set variables
APP_DIR=$(basename $(pwd))
SRCS_COMMON="\
       ../src/sdlx_misc.c \
       ../src/sdlx_video.c \
       ../src/sdlx_audio.c \
       ../src/sdlx_sensor.c \
       ../src/sdlx_event.c \
       ../src/utils.c \
       ../src/utils_location.cpp \
       ../src/logging.c \
       ../cJSON/cJSON.c \
       ../lodepng/lodepng.c"

APP_NAME=$APP_DIR
CFLAGS="-Wall -Werror -Wno-unused-result -g -I. -I../src -fcommon $(pkg-config sdl3 --cflags)"
DATA_DIR="${PARENT_DIR}_data/$APP_NAME"

# build and run is performed from the 'files' dir
cd ../..

# get list of src files, relative to the 'files' dir
SRCS=$(echo $PARENT_DIR/$APP_DIR/*.c)

# debug
#echo "PARENT_DIR  = $PARENT_DIR"
#echo "APP_DIR     = $APP_DIR"
#echo "SRCS        = $SRCS"
#echo "SRCS_COMMON = $SRCS_COMMON"
#echo "CFLAGS      = $CFLAGS"
#echo "DATA_DIR    = $DATA_DIR"

# perform command
if [ "$CMD" = build ]; then
    set -x
    gcc -o /tmp/$APP_NAME $CFLAGS $SRCS $SRCS_COMMON -lSDL3 -lSDL3_ttf -lm || exit 1
    set +x
elif [ "$CMD" = linux ]; then
    set -x
    gcc -o /tmp/$APP_NAME $CFLAGS $SRCS $SRCS_COMMON -lSDL3 -lSDL3_ttf -lm || exit 1
    set +x
    mkdir -p $DATA_DIR
    exec -a  $PARENT_DIR/$APP_NAME /tmp/$APP_NAME $DATA_DIR 0
elif [ "$CMD" = picoc ]; then
    mkdir -p $DATA_DIR
    ../picoc/picoc -n $PARENT_DIR/$APP_NAME $SRCS - $DATA_DIR 0
fi

