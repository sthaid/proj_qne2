#!/bin/bash

# get CMD and validate
CMD=$1
if [ "$CMD" != build -a "$CMD" != run_linux -a "$CMD" != run_picoc ]; then
    echo "ERROR: arg expected: build, run_linux, run_picoc"
    exit 1
fi

# verify parent directory is 'apps' or 'svcs'
PARENT_DIR=$(basename $(dirname $PWD))
if [ "$PARENT_DIR" != apps -a "$PARENT_DIR" != svcs ]; then
    echo "ERROR: parent_dir must be apps or svcs"
    exit 1
fi

# set variables
APP_DIR=$(basename $(pwd))
SRCS_COMMON="\
       ../src/sdl_misc.c \
       ../src/sdl_video.c \
       ../src/sdl_audio.c \
       ../src/sdl_sensor.c \
       ../src/sdl_event.c \
       ../src/utils.c \
       ../src/logging.c \
       ../cJSON/cJSON.c"

TARGET=$APP_DIR
CFLAGS="-Wall -Werror -Wno-unused-result -g -I. -I../src -fcommon $(pkg-config sdl3 --cflags)"
DATA_DIR="${PARENT_DIR}_data/$TARGET"

# build and run is performed from the 'files' dir
cd ../..

# get list of src files, relative to the 'files' dir
SRCS=$(echo $PARENT_DIR/$APP_DIR/*.c)

# debug
#echo $PARENT_DIR
#echo $APP_DIR
#echo $SRCS
#echo $SRCS_COMMON
#echo $CFLAGS
#echo $DATA_DIR

# perform command
if [ "$CMD" = build ]; then
    set -x
    gcc -o /tmp/$TARGET $CFLAGS $SRCS $SRCS_COMMON -lSDL3 -lSDL3_ttf -lm || exit 1
    set +x
elif [ "$CMD" = run_linux ]; then
    set -x
    gcc -o /tmp/$TARGET $CFLAGS $SRCS $SRCS_COMMON -lSDL3 -lSDL3_ttf -lm || exit 1
    set +x
    mkdir -p $DATA_DIR
    /tmp/$TARGET $DATA_DIR 0
elif [ "$CMD" = run_picoc ]; then
    mkdir -p $DATA_DIR
    ../picoc/picoc -n $TARGET $SRCS - $DATA_DIR 0
fi

