===============================
SDL3 ANDROID BUILD DIRECTORY STRUCT
===============================

├── app
│   ├── jni
│   │   ├── SDL                   : SDL3 code
│   │   ├── SDL3_ttf-3.2.2        : SDL3_ttf code
│   │   └── src                   : app C-language code
│   └── src
│       └── main
│           ├── assets            : files that can be accessed using SDL_LoadFile
│           ├── java
│           │   └── org
│           │       ├── libsdl
│           │       │   └── app   : main java code, SDLActivity.java ...
│           │       └── sthaid
│           │           └── ezApp : EzappActivity.java (stub file)
│           └── res               : icons and values
└── gradle
    └── wrapper

