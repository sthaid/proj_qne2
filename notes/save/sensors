            compass_sensor = SDL_SensorOpen(i);
            if (compass_sensor == NULL) {
                SDL_Log("Couldn't open compass sensor: %s\n", SDL_GetError());
            } else {
                SDL_Log("Opened compass sensor: %s\n", SDL_SensorGetDeviceName(i));
                break;
            }
        }
    }

    // ... (Main event loop)
    SDL_Event event;
    while (!done) {
        while (SDL_PollEvent(&event) > 0) {
            switch (event.type) {
                case SDL_SENSORUPDATE:
                    if (event.sensor.which == SDL_SensorGetInstanceID(compass_sensor)) {
                        // event.sensor.data[0], event.sensor.data[1], event.sensor.data[2]
                        // contain the magnetic field data (x, y, z)
                        // Implement your compass heading calculation here
                        SDL_Log("Compass update: %.2f, %.2f, %.2f\n",
                                event.sensor.data[0], event.sensor.data[1], event.sensor.data[2]);
                    }
                    break;
                // ... (Other event handling)
            }
        }
        // ... (Rendering and other game logic)
    }

    // ... (SDL cleanup and sensor closing)
    if (compass_sensor) {
        SDL_SensorClose(compass_sensor);
    }
    SDL_Quit();
    return 0;
}

