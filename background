#include <SDL3/SDL.h>
#include <iostream>

void permissionCallback(void* userdata, const char* permission, SDL_bool granted) {
    if (granted) {
        std::cout << "Permission " << permission << " granted!" << std::endl;
    } else {
        std::cerr << "Permission " << permission << " denied." << std::endl;
    }
}

// Inside your main() or a setup function:
